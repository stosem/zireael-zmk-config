#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &extra_keys_transform;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp TAB              &kp Q  &kp W  &kp E      &kp R                 &kp T                &kp Y            &kp U        &kp I                  &kp O    &kp P     &kp LBKT
&mt LEFT_ALT MINUS   &kp A  &kp S  &kp D      &kp F                 &kp G                &kp H            &kp J        &kp K                  &kp L    &kp SEMI  &kp APOSTROPHE
&mt RIGHT_ALT GRAVE  &kp Z  &kp X  &kp C      &kp V                 &kp B                &kp N            &kp M        &kp COMMA              &kp DOT  &kp FSLH  &kp BACKSLASH
                                   &kp LCTRL  &mt LEFT_SHIFT SPACE  &mt LEFT_GUI ESCAPE  &lt 2 BACKSPACE  &lt 1 SPACE  &mt RIGHT_SHIFT ENTER
            >;
        };

        lower_layer {
            bindings = <
&kp ESCAPE  &kp N1    &kp N2  &kp N3    &kp N4          &kp N5        &kp N6           &kp N7    &kp N8    &kp N9    &kp N0    &kp RIGHT_BRACKET
&kp PLUS    &kp EXCL  &kp AT  &kp HASH  &kp DLLR        &kp PRCNT     &kp CARET        &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp MINUS
&kp EQUAL   &kp F1    &kp F2  &kp F3    &kp F4          &kp F5        &kp F6           &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
                              &trans    &kp LEFT_SHIFT  &kp CAPSLOCK  &lt 3 BACKSPACE  &trans    &trans
            >;
        };

        raise_layer {
            bindings = <
&kp ESCAPE  &kp PG_UP      &mkp LCLK       &mmv MOVE_UP    &mkp RCLK          &msc SCRL_UP     &kp C_VOL_UP  &kp HOME     &kp UP    &kp PG_UP  &none            &kp RIGHT_BRACKET
&kp PLUS    &kp PAGE_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT    &msc SCRL_DOWN   &kp C_MUTE    &kp LEFT     &kp DOWN  &kp RIGHT  &kp INS          &mt RCTRL K_APP
&kp C_PREV  &kp C_STOP     &kp C_NEXT      &kp C_MUTE      &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp C_VOL_DN  &kp END      &none     &kp PG_DN  &kp PAUSE_BREAK  &trans
                                           &trans          &trans             &lt 3 ESCAPE     &trans        &lt 3 SPACE  &trans
            >;
        };

        adjust_layer {
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &bootloader
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &sys_reset
                                         &trans        &none         &trans        &trans        &none         &trans
            >;
        };
    };
};
