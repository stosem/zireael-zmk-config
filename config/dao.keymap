#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    chosen {
        zmk,matrix_transform = &default_transform;

        // zmk,matrix_transform = &extra_keys_transform;
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE            &kp Q  &kp W  &kp E      &kp R                 &kp T                &kp Y            &kp U        &kp I                  &kp O    &kp P     &kp LBKT
&mt LEFT_ALT TAB     &kp A  &kp S  &kp D      &kp F                 &kp G                &kp H            &kp J        &kp K                  &kp L    &kp SEMI  &kp APOSTROPHE
&mt RIGHT_ALT MINUS  &kp Z  &kp X  &kp C      &kp V                 &kp B                &kp N            &kp M        &kp COMMA              &kp DOT  &kp FSLH  &kp BACKSLASH
                                   &kp LCTRL  &mt LEFT_SHIFT SPACE  &mt LEFT_GUI ESCAPE  &lt 2 BACKSPACE  &lt 1 SPACE  &mt RIGHT_SHIFT ENTER
            >;
        };

        lower_layer {
            bindings = <
&kp PLUS   &kp N1    &kp N2  &kp N3    &kp N4        &kp N5     &kp N6           &kp N7    &kp N8    &kp N9    &kp N0    &kp DEL
&trans     &kp EXCL  &kp AT  &kp HASH  &kp DLLR      &kp PRCNT  &kp CARET        &kp AMPS  &kp STAR  &kp LPAR  &kp RPAR  &kp MINUS
&kp EQUAL  &kp F1    &kp F2  &kp F3    &kp F4        &kp F5     &kp F6           &kp F7    &kp F8    &kp F9    &kp F10   &kp F11
                             &trans    &kp CAPSLOCK  &trans     &lt 3 BACKSPACE  &trans    &trans
            >;
        };

        raise_layer {
            bindings = <
&kp PLUS   &kp KP_SLASH     &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_MINUS  &kp C_VOL_UP  &kp HOME     &kp UP    &kp PG_UP  &none            &kp RIGHT_BRACKET
&trans     &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS   &kp ENTER     &kp LEFT     &kp DOWN  &kp RIGHT  &kp INS          &mt RCTRL K_APP
&kp EQUAL  &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT    &kp C_VOL_DN  &kp END      &none     &kp PG_DN  &kp PAUSE_BREAK  &trans
                                       &trans     &trans     &lt 3 ESCAPE  &trans        &lt 3 SPACE  &trans
            >;
        };

        adjust_layer {
            bindings = <
&bootloader  &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &bootloader
&bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
&sys_reset   &none         &none         &none         &none         &none         &none         &none         &none         &none         &none         &sys_reset
                                         &trans        &none         &trans        &trans        &none         &trans
            >;
        };
    };
};
